#!/usr/bin/env bash
set -euo pipefail

mode="${1:-0}"
if [[ "$mode" == "large" ]]; then
  for ((index = 0; index < 512; index++)); do
    printf 'stdout-%04d-abcdefghijklmnopqrstuvwxyz\n' "$index"
    printf 'stderr-%04d-abcdefghijklmnopqrstuvwxyz\n' "$index" >&2
  done
  exit 0
fi
if [[ "$mode" == "sleep" ]]; then
  sleep "${2:-1}"
  exit 0
fi
if [[ "$mode" == "git" ]]; then
  printf 'Receiving objects:  10%%\nReceiving objects:  10%%\nReceiving objects:  10%%\nReceiving objects:  10%%\nup to date\n'
  exit 0
fi
if [[ "$mode" == "json" ]]; then
  printf '{\n  "name": "fixture",\n  "ok": true,\n  "count": 3\n}\n'
  exit 0
fi

printf '\033[31merror\033[0m\n\nerror\nerror\n'
printf 'SECRET=must-not-persist\n' >&2
exit "$mode"
