      "crash_point": "replace_ccr_metadata: staged DELETE+INSERT inside the transaction, before commit",
      "durability_mode": "n/a",
      "terminal_state": "previous_projection_intact_never_partial",
      "test": "crash_before_ccr_replace_commit_keeps_the_previous_view",
      "test_kind": "projection rebuild fault matrix"
    }
  ]
}
