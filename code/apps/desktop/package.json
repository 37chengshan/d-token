{
  "name": "d-token-desktop",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "generate:promo": "node scripts/generate-promo-images.mjs",
    "generate:promo-v2": "node scripts/generate-promo-v2.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=macos-webkit",
    "check:structure": "python3 ../../../support/scripts/check_structure.py",
    "check:release-version": "python3 ../../../support/scripts/check_release_version.py",
    "check:release-scope": "python3 ../../../support/scripts/check_release_scope.py",
    "check:release-metadata": "python3 ../../../support/scripts/generate_release_metadata.py --skip-audits",
    "check:release-security": "python3 ../../../support/scripts/generate_release_metadata.py",
    "check:prepare-macos-sidecars": "bash ../../../support/scripts/prepare_desktop_sidecars_macos.sh --debug",
    "check:rust-fmt": "cd ../.. && cargo fmt --all -- --check",
    "check:rust-clippy": "cd ../.. && cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cd ../.. && cargo test --workspace",
    "generate:release-metadata": "python3 ../../../support/scripts/generate_release_metadata.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:with-sidecar": "node scripts/tauri-with-sidecar.mjs",
    "tauri:dev": "npm run tauri:with-sidecar -- dev",
    "tauri:build": "npm run tauri:with-sidecar -- build"
  },
