{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "d-token",
  "version": "0.0.1",
  "identifier": "ai.dtoken.control-plane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "d-token Control Plane",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640
      },
      {
        "label": "tray-panel",
        "title": "d-token",
        "url": "index.html?surface=tray",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../../LICENSE": "legal/LICENSE",
      "../../../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "binaries/WebView2Loader.dll": "",
      "binaries/codebase-memory/LICENSE": "codebase-memory/LICENSE",
      "binaries/codebase-memory/THIRD_PARTY_NOTICES.md": "codebase-memory/THIRD_PARTY_NOTICES.md"
    },
    "externalBin": [
      "binaries/dtoken-proxy",
      "binaries/dtoken-agent-bridge",
      "binaries/dtoken-codebase-memory-launcher"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI coding token compression and routing control plane",
    "longDescription": "d-token is a local-first AI coding compression, routing, diagnostics, dashboard, and rollback desktop control plane."
  }
}
