{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "d-token",
  "version": "0.1.0",
  "identifier": "ai.dtoken.control-plane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "d-token Control Plane",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
